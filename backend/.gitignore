# ── Qué NO se sube a GitHub ───────────────────────────────
# Ojo: en .gitignore los comentarios van siempre en su propia línea.
# Un «# comentario» al final de una regla la rompe sin avisar.

# Tus claves secretas (la plantilla .env.example sí se sube)
.env
.env.*
!.env.example

# Caché de Python
__pycache__/
*.pyc
.pytest_cache/

# Entorno virtual de Python
.venv/
venv/

# Bases de datos locales de pruebas
*.db
*.sqlite3

# Configuración local de editores y del sistema
.idea/
.DS_Store
